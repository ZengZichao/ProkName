# The Zenodo concept DOI, not a version DOI: it resolves to the latest archived
# release and never needs bumping alongside `version`, so it cannot drift.
doi: "10.5281/zenodo.23052777"
license: MIT
license-url: "https://opensource.org/licenses/MIT"
repository-code: "https://github.com/ZengZichao/ProkName"
keywords:
  - nomenclature
  - taxonomy
