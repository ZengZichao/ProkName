# The image context needs pyproject.toml, README.md, LICENSE, DATA_LICENSE, src/ and
# scripts/ — nothing else. Everything below is a local cache, a build product, or a
# developer-machine file.
#
# .venv/ is the one that actually bites: a host virtualenv copied into the context lands
# inside a python:3.13-slim image built from a different interpreter, and `docker build`
# then either fails on an incompatible wheel or succeeds with the host's packages.
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.hypothesis/
.tox/
.mimosa/

# Generated by running the tool or CI, never hand-edited.
.coverage
.coverage.*
coverage.xml
htmlcov/
results.xml
benchmark_results.json
build/
dist/

# Not part of the wheel: the image installs prokname, it does not test or package it.
tests/
docs/
recipes/
conftest.py
requirements*.txt
Dockerfile
.dockerignore

# OS / editor / secret noise.
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.vscode/
.idea/
.env
.env.*
*.keytab
*.pem
*.key
